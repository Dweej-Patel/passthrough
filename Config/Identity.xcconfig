// Reverse-DNS base for every bundle ID, the App Group, keychain services and
// the launchd label. Override it in Signing.xcconfig to build under your own
// team; Swift reads it back through PassthroughProtocol.identifier.
PASSTHROUGH_ID = dev.dpatel.passthrough

// The team the APNs push key belongs to (Signing.xcconfig may name another).
PASSTHROUGH_PUSH_TEAM_ID = $(DEVELOPMENT_TEAM)

#include? "Signing.xcconfig"
