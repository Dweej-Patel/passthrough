<?xml version="1.0" encoding="utf-8"?>
<!-- Every package comes from nuget.org and nowhere else, whatever feeds this PC
     has configured. The versions and content hashes are pinned in each
     project's packages.lock.json (see windows/README.md, Build). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
