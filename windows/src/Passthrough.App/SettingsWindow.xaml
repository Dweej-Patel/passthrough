<Window
    x:Class="Passthrough.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Passthrough.App"
    Title="Passthrough settings">

    <!-- No background of its own: the window's Mica shows through. One card per group, as in Windows Settings. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- The title bar: kept above the scrolling content, so nothing scrolls under the caption buttons. -->
        <Grid x:Name="TitleBarArea" Grid.Row="0">
            <TextBlock Text="Passthrough settings" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                       Margin="16,0,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    <ScrollViewer Grid.Row="1">
        <StackPanel Padding="24,4,24,24" Spacing="8" MaxWidth="560">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8" />

            <Border x:Name="ErrorBox" Visibility="Collapsed" Background="{StaticResource PtAttentionFillBrush}"
                    CornerRadius="6" Padding="12,10">
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" />
            </Border>

            <TextBlock Text="General" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
            <Border Style="{StaticResource PtCardStyle}" Padding="16,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Start at login" />
                        <TextBlock Text="Passthrough starts in the tray when you sign in to Windows."
                                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="StartAtLoginSwitch" Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                                  AutomationProperties.Name="Start at login" />
                </Grid>
            </Border>
            <Border Style="{StaticResource PtCardStyle}" Padding="16,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Android support" />
                        <TextBlock Text="On: Android phones are listed once adb finds them. Off: they are ignored."
                                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AndroidSwitch" Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                                  AutomationProperties.Name="Android support" />
                </Grid>
            </Border>

            <TextBlock Text="Remote access" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,0" />
            <Border Style="{StaticResource PtCardStyle}" Padding="16,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Use this PC's shell from your phones" />
                        <TextBlock x:Name="RemoteStatusText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <ToggleSwitch x:Name="RemoteSwitch" Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                                  AutomationProperties.Name="Remote access" />
                </Grid>
            </Border>
            <TextBlock x:Name="ShellsText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Border Style="{StaticResource PtCardStyle}" Padding="16,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Screen, through Remote Desktop" />
                        <TextBlock x:Name="ScreenText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"
                                   Text="Turn Remote access on first." />
                    </StackPanel>
                    <Button x:Name="ScreenButton" Grid.Column="1" Visibility="Collapsed" Click="OnScreenActionClick" />
                </Grid>
            </Border>
            <Border x:Name="AwakeCard" Style="{StaticResource PtCardStyle}" Padding="16,12" Visibility="Collapsed">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Stay awake while plugged in" />
                        <TextBlock x:Name="AwakeText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AwakeSwitch" Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                                  AutomationProperties.Name="Stay awake while plugged in" Toggled="OnAwakeToggled" />
                </Grid>
            </Border>

            <Border Style="{StaticResource PtCardStyle}" Padding="16,12">
                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Keep shell history" />
                        <TextBlock Text="What phones' shells showed, kept on this PC for you to look back at. Only your Windows account can open it."
                                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox x:Name="HistoryChoice" Grid.Column="1" VerticalAlignment="Center" MinWidth="120"
                              AutomationProperties.Name="Keep shell history" />
                    <HyperlinkButton x:Name="DeleteHistoryButton" Grid.Row="1" Content="Delete shell history" Padding="0"
                                     Click="OnDeleteHistoryClick" />
                </Grid>
            </Border>
            <Border Style="{StaticResource PtCardStyle}" Padding="16,12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Relay" />
                    <TextBlock x:Name="RelayText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBox x:Name="RelayUrlBox" PlaceholderText="https://relay.example.com (empty: n0's public relays)"
                             AutomationProperties.Name="Relay address" />
                    <PasswordBox x:Name="RelayTokenBox" PlaceholderText="Token, if your relay needs one"
                                 AutomationProperties.Name="Relay token" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Use this relay" Click="OnRelayClick" />
                        <HyperlinkButton Content="Reset this PC's identity…" Click="OnResetIdentityClick" />
                    </StackPanel>
                    <TextBlock Text="Once Remote access runs as a background service, changing either asks for an administrator."
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
            <TextBlock Text="Phones with access" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,0" />
            <Border x:Name="NoAccessText" Style="{StaticResource PtCardStyle}" Padding="16,14" Visibility="Collapsed">
                <TextBlock Text="No phone can open shells here yet. With Remote access on, plug a paired phone in once."
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>
            <ItemsControl ItemsSource="{x:Bind WithAccess}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:RemotePhoneRow">
                        <Border Style="{StaticResource PtCardStyle}" Padding="16,12">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="32" Height="32">
                                    <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Content="Screen" MinWidth="0" IsChecked="{x:Bind Screen}" IsEnabled="{x:Bind ScreenSwitchEnabled}"
                                          Click="OnScreenClick" AutomationProperties.Name="Let it see the screen"
                                          ToolTipService.ToolTip="Let it see and control this PC's screen. Windows still asks for your password." />
                                <Button Grid.Column="3" Content="Stop" Click="OnStopClick" IsEnabled="{x:Bind CanStop}"
                                        ToolTipService.ToolTip="End its connection and the shells it opened. It keeps its access." />
                                <Button Grid.Column="4" Content="Revoke" Click="OnRevokeClick" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Paired phones" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,0" />
            <TextBlock Text="Every phone this PC holds a pairing for, attached or not. Forget one you no longer use."
                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Border x:Name="NoPairingsText" Style="{StaticResource PtCardStyle}" Padding="16,14" Visibility="Collapsed">
                <TextBlock Text="No phone is paired with this PC." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>
            <ItemsControl ItemsSource="{x:Bind Paired}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:PairedPhoneRow">
                        <Border Style="{StaticResource PtCardStyle}" Padding="16,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="32" Height="32">
                                    <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Forget pairing" Click="OnForgetClick" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Window>
