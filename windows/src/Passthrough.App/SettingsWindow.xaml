<Window
    x:Class="Passthrough.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Passthrough.Core.Presentation"
    Title="Passthrough settings">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="20" MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

            <StackPanel Spacing="8">
                <TextBlock Text="General" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ToggleSwitch x:Name="StartAtLoginSwitch" Header="Start at login" />
                <ToggleSwitch x:Name="AndroidSwitch" Header="Android support"
                              OnContent="On: Android phones are listed once adb finds them"
                              OffContent="Off: Android phones are ignored" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Paired phones" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Every phone this PC holds a pairing for, attached or not. Forget one you no longer use."
                           Opacity="0.7" TextWrapping="Wrap" />
                <TextBlock x:Name="NoPairingsText" Text="No phone is paired with this PC." Opacity="0.7" Visibility="Collapsed" />
                <ItemsControl ItemsSource="{x:Bind Paired}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:PairedPhone">
                            <Grid ColumnSpacing="12" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" />
                                    <TextBlock Text="{x:Bind Detail}" Opacity="0.7" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Forget pairing" Click="OnForgetClick" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
