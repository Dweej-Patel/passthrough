<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Passthrough.App</RootNamespace>
    <AssemblyName>Passthrough</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged: a plain exe, no MSIX. The Windows App SDK runtime ships beside it. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The exe's own icon (Explorer, the taskbar, Task Manager); the same file is loaded at run time for the tray and the windows. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ConptyRequiresx64Host>true</ConptyRequiresx64Host>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.251106002" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.2.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <!-- Directly too, so conpty.dll and x64\OpenConsole.exe ship beside Passthrough.exe (Passthrough.Windows uses them). -->
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" Version="1.25.261109001" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Passthrough.Core\Passthrough.Core.csproj" />
    <ProjectReference Include="..\Passthrough.Windows\Passthrough.Windows.csproj" />
    <ProjectReference Include="..\Passthrough.Media\Passthrough.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
