<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>ConPtyProbe</RootNamespace>
    <AssemblyName>ConPtyProbe</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <!-- The package's props run before this file sets PlatformTarget, so name the host to ship here. -->
    <ConptyRequiresx64Host>true</ConptyRequiresx64Host>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" Version="1.25.261109001" />
  </ItemGroup>

</Project>
