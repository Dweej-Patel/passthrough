<Project Sdk="Microsoft.NET.Sdk">
  <!-- Spike: can Windows' own drag-and-drop be driven by SendInput alone, so a file lands in whatever is at a point?
       It compiles the product's DropPerformer as it is. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\windows\src\Passthrough.Windows\ClipSync\DropPerformer.cs" Link="DropPerformer.cs" />
  </ItemGroup>
</Project>
